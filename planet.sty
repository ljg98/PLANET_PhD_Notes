%███████████████████████████████EXAMPLE BOXES█
\newtcolorbox{example}[3][parbox=false]{
skin=bicolor,
colbacktitle=primer_dark,
colback=white,
overlay unbroken and first={\node[anchor=north east,outer sep=-1pt] at (frame.north east) {\begin{tikzpicture}
\draw[primer_light, line width = 1, fill=primer_light] (7,0) circle(6pt);
\draw[primer_light, line width = 1, fill=\ifnum#2>1 primer_light\else none\fi] (7.5,0) circle(6pt);
\draw[primer_light, line width = 1, fill=\ifnum#2>2 primer_light\else none\fi] (8,0) circle(6pt);
\end{tikzpicture}};},
enhanced,
coltitle=white, 
colframe = primer_dark,
%frame style={draw=none,fill=none},
title={#3}\phantom{p},
fonttitle=\bfseries,
#1}

