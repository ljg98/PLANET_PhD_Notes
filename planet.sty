%███████████████████████████TITLE FORMATTING PACKAGES█
\usepackage[raggedright, explicit]{titlesec}
\usepackage[skins, breakable]{tcolorbox}
\usepackage{environ}

\titleformat{\chapter}[display]
    {\normalfont\Huge\bfseries}
    {}
    {0em}
    {\begin{tcolorbox}[
    enhanced,
    halign=center,
    valign=center,
    box align=center,
    title={\Large\textbf{\thechapter}},
    attach boxed title to top center={yshift=-4mm,yshifttext=-1mm},
    coltitle=black,
    colframe=primer_dark,
    colback=white,
    boxrule=2pt,
    arc=10pt,
    boxed title style={size=small,colback=white,colframe=white}
    ]
#1
\end{tcolorbox}
}
\titlespacing{\chapter}{0pt}{-7em}{-3em}
\setcounter{secnumdepth}{2}

\newtcbox{\keyframe}{
    enhanced,
    center,
    fontupper=\Huge\bfseries,
    box align=center,
    halign=center,
    valign=center,
    colframe=iop_grey,
    colback=white,
    boxrule=2pt,
    arc=10pt
    }
