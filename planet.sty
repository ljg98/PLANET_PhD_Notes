\usepackage{titletoc}
\newtcbox{\contentsframe}{
    enhanced,
    center,
    fontupper=\Huge\bfseries,
    box align=center,
    halign=center,
    valign=center,
    colframe=iop_grey,
    colback=white,
    boxrule=2pt,
    arc=10pt
    }
    
\renewcommand{\thesection}{\arabic{chapter}.\arabic{section}}
\titlecontents{part}[0em]
{\Large\bfseries\protect\addvspace{5pt}}
{\thecontentslabel:XYZ\enskip}{}
{\hfill}

\titlecontents{chapter}[0em]
{\large\bfseries\protect\addvspace{5pt}}%
{\thecontentslabel:\enskip}{}% 
{\hspace{0.4em}}%

\renewcommand{\tableofcontents}{%
    \section*{\contentsname
        \@mkboth{%
           \MakeUppercase\contentsname}{\MakeUppercase\contentsname}}%
    \@starttoc{toc}%
    }

\renewcommand{\contentsname}{\hfill \contentsframe{Table of Contents}\hfill}


